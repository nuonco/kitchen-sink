{
  "uid": "kitchen-sink-fleet",
  "title": "Kitchen Sink \u00b7 Fleet",
  "description": "Every kitchen-sink install reporting through Nuon install telemetry, side by side. Installs are identified by the relay-verified nuon.install.id.",
  "tags": [
    "kitchen-sink",
    "nuon",
    "install-telemetry"
  ],
  "timezone": "browser",
  "editable": true,
  "graphTooltip": 1,
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "refresh": "30s",
  "schemaVersion": 39,
  "version": 1,
  "templating": {
    "list": [
      {
        "name": "ds_prometheus",
        "label": "Metrics",
        "type": "datasource",
        "query": "prometheus",
        "current": {},
        "hide": 0,
        "refresh": 1,
        "options": []
      },
      {
        "name": "ds_loki",
        "label": "Logs",
        "type": "datasource",
        "query": "loki",
        "current": {},
        "hide": 0,
        "refresh": 1,
        "options": []
      },
      {
        "name": "ds_tempo",
        "label": "Traces",
        "type": "datasource",
        "query": "tempo",
        "current": {},
        "hide": 0,
        "refresh": 1,
        "options": []
      },
      {
        "name": "install",
        "label": "Install",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${ds_prometheus}"
        },
        "query": {
          "query": "query_result(count by (nuon_install_id, nuon_install_name) (target_info{service_namespace=\"kitchen-sink\", nuon_install_id!=\"\"}))",
          "refId": "install"
        },
        "regex": "/nuon_install_id=\"(?<value>[^\"]+)\",nuon_install_name=\"(?<text>[^\"]+)\"/",
        "refresh": 2,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "hide": 0,
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "allValue": ".+"
      }
    ]
  },
  "annotations": {
    "list": []
  },
  "links": [
    {
      "title": "Install view",
      "type": "link",
      "url": "/d/kitchen-sink-install",
      "icon": "dashboard",
      "keepTime": true,
      "includeVars": false
    }
  ],
  "panels": [
    {
      "type": "row",
      "title": "Fleet at a glance",
      "id": 1,
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "panels": []
    },
    {
      "type": "stat",
      "title": "Installs reporting",
      "description": "Installs whose telemetry reached this backend in the last few minutes, by the relay-verified nuon.install.id.",
      "datasource": {
        "type": "prometheus",
        "uid": "${ds_prometheus}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${ds_prometheus}"
          },
          "expr": "count(count by (nuon_install_id) (target_info{service_namespace=\"kitchen-sink\", nuon_install_id=~\"$install\"}))",
          "refId": "A",
          "legendFormat": "__auto",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto",
        "justifyMode": "center"
      },
      "id": 2,
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 0,
        "y": 1
      }
    },
    {
      "type": "stat",
      "title": "Jobs / s",
      "description": "Background jobs processed per second across the selected installs.",
      "datasource": {
        "type": "prometheus",
        "uid": "${ds_prometheus}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${ds_prometheus}"
          },
          "expr": "sum((rate(kitchen_sink_jobs_processed_total[$__rate_interval])) * on (job, instance) group_left (nuon_install_id, nuon_install_name) group by (job, instance, nuon_install_id, nuon_install_name) (target_info{service_namespace=\"kitchen-sink\", nuon_install_id=~\"$install\"}))",
          "refId": "A",
          "legendFormat": "__auto",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          },
          "decimals": 2
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto",
        "justifyMode": "center"
      },
      "id": 3,
      "gridPos": {
        "h": 4,
        "w": 5,
        "x": 4,
        "y": 1
      }
    },
    {
      "type": "stat",
      "title": "Job failure rate",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "${ds_prometheus}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${ds_prometheus}"
          },
          "expr": "sum((rate(kitchen_sink_jobs_processed_total{job_outcome=\"failure\"}[$__rate_interval])) * on (job, instance) group_left (nuon_install_id, nuon_install_name) group by (job, instance, nuon_install_id, nuon_install_name) (target_info{service_namespace=\"kitchen-sink\", nuon_install_id=~\"$install\"})) / sum((rate(kitchen_sink_jobs_processed_total[$__rate_interval])) * on (job, instance) group_left (nuon_install_id, nuon_install_name) group by (job, instance, nuon_install_id, nuon_install_name) (target_info{service_namespace=\"kitchen-sink\", nuon_install_id=~\"$install\"}))",
          "refId": "A",
          "legendFormat": "__auto",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.03
              },
              {
                "color": "red",
                "value": 0.1
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          },
          "decimals": 1
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "auto",
        "justifyMode": "center"
      },
      "id": 4,
      "gridPos": {
        "h": 4,
        "w": 5,
        "x": 9,
        "y": 1
      }
    },
    {
      "type": "stat",
      "title": "API p95 latency",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "${ds_prometheus}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${ds_prometheus}"
          },
          "expr": "histogram_quantile(0.95, sum by (le) ((rate(http_server_request_duration_seconds_bucket{service_name=\"kitchen-sink-api\"}[$__rate_interval])) * on (job, instance) group_left (nuon_install_id, nuon_install_name) group by (job, instance, nuon_install_id, nuon_install_name) (target_info{service_namespace=\"kitchen-sink\", nuon_install_id=~\"$install\"})))",
          "refId": "A",
          "legendFormat": "__auto",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.25
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          },
          "decimals": 3
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto",
        "justifyMode": "center"
      },
      "id": 5,
      "gridPos": {
        "h": 4,
        "w": 5,
        "x": 14,
        "y": 1
      }
    },
    {
      "type": "stat",
      "title": "Error logs (range)",
      "description": "Error-level log lines across the selected installs in the dashboard time range.",
      "datasource": {
        "type": "loki",
        "uid": "${ds_loki}"
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "${ds_loki}"
          },
          "refId": "A",
          "queryType": "instant",
          "expr": "sum(count_over_time({service_namespace=\"kitchen-sink\"} | nuon_install_id=~\"$install\" | detected_level=\"error\" [$__range]))"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 50
              },
              {
                "color": "red",
                "value": 500
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          },
          "noValue": "0"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto",
        "justifyMode": "center"
      },
      "id": 6,
      "gridPos": {
        "h": 4,
        "w": 5,
        "x": 19,
        "y": 1
      }
    },
    {
      "type": "table",
      "title": "Install health",
      "description": "One row per install. Click an install name to open its install view.",
      "datasource": {
        "type": "prometheus",
        "uid": "${ds_prometheus}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${ds_prometheus}"
          },
          "expr": "sum by (nuon_install_id, nuon_install_name) ((rate(kitchen_sink_jobs_processed_total[$__rate_interval])) * on (job, instance) group_left (nuon_install_id, nuon_install_name) group by (job, instance, nuon_install_id, nuon_install_name) (target_info{service_namespace=\"kitchen-sink\", nuon_install_id=~\"$install\"}))",
          "refId": "jobs",
          "legendFormat": "__auto",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${ds_prometheus}"
          },
          "expr": "100 * (1 - (sum by (nuon_install_id, nuon_install_name) ((rate(kitchen_sink_jobs_processed_total{job_outcome=\"failure\"}[$__rate_interval])) * on (job, instance) group_left (nuon_install_id, nuon_install_name) group by (job, instance, nuon_install_id, nuon_install_name) (target_info{service_namespace=\"kitchen-sink\", nuon_install_id=~\"$install\"})) or sum by (nuon_install_id, nuon_install_name) ((rate(kitchen_sink_jobs_processed_total[$__rate_interval])) * on (job, instance) group_left (nuon_install_id, nuon_install_name) group by (job, instance, nuon_install_id, nuon_install_name) (target_info{service_namespace=\"kitchen-sink\", nuon_install_id=~\"$install\"})) * 0) / sum by (nuon_install_id, nuon_install_name) ((rate(kitchen_sink_jobs_processed_total[$__rate_interval])) * on (job, instance) group_left (nuon_install_id, nuon_install_name) group by (job, instance, nuon_install_id, nuon_install_name) (target_info{service_namespace=\"kitchen-sink\", nuon_install_id=~\"$install\"})))",
          "refId": "success",
          "legendFormat": "__auto",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${ds_prometheus}"
          },
          "expr": "histogram_quantile(0.95, sum by (le, nuon_install_id, nuon_install_name) ((rate(http_server_request_duration_seconds_bucket{service_name=\"kitchen-sink-api\"}[$__rate_interval])) * on (job, instance) group_left (nuon_install_id, nuon_install_name) group by (job, instance, nuon_install_id, nuon_install_name) (target_info{service_namespace=\"kitchen-sink\", nuon_install_id=~\"$install\"})))",
          "refId": "p95",
          "legendFormat": "__auto",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${ds_prometheus}"
          },
          "expr": "max by (nuon_install_id, nuon_install_name) ((kitchen_sink_jobs_backlog) * on (job, instance) group_left (nuon_install_id, nuon_install_name) group by (job, instance, nuon_install_id, nuon_install_name) (target_info{service_namespace=\"kitchen-sink\", nuon_install_id=~\"$install\"}))",
          "refId": "backlog",
          "legendFormat": "__auto",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${ds_prometheus}"
          },
          "expr": "count by (nuon_install_id, nuon_install_name, service_version) (target_info{service_namespace=\"kitchen-sink\", service_name=\"kitchen-sink-worker\", nuon_install_id=~\"$install\"})",
          "refId": "version",
          "legendFormat": "__auto",
          "instant": true,
          "range": false,
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "joinByField",
          "options": {
            "byField": "nuon_install_name",
            "mode": "outer"
          }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "Time 1": true,
              "Time 2": true,
              "Time 3": true,
              "Time 4": true,
              "Time 5": true,
              "nuon_install_id 2": true,
              "nuon_install_id 3": true,
              "nuon_install_id 4": true,
              "nuon_install_id 5": true,
              "Value #version": true
            },
            "renameByName": {
              "nuon_install_name": "Install",
              "nuon_install_id 1": "Install ID",
              "nuon_install_id": "Install ID",
              "service_version": "Version",
              "Value #jobs": "Jobs / s",
              "Value #success": "Job success",
              "Value #p95": "API p95",
              "Value #backlog": "Backlog"
            },
            "indexByName": {
              "nuon_install_name": 0,
              "service_version": 1,
              "Value #success": 2,
              "Value #jobs": 3,
              "Value #p95": 4,
              "Value #backlog": 5,
              "nuon_install_id 1": 6,
              "nuon_install_id": 6
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            }
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Install"
            },
            "properties": [
              {
                "id": "links",
                "value": [
                  {
                    "title": "Open install view",
                    "url": "/d/kitchen-sink-install?var-install=${__data.fields[\"Install ID\"]}&${ds_prometheus:queryparam}&${ds_loki:queryparam}&${ds_tempo:queryparam}&${__url_time_range}"
                  }
                ]
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Job success"
            },
            "properties": [
              {
                "id": "unit",
                "value": "percent"
              },
              {
                "id": "decimals",
                "value": 1
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "red",
                      "value": null
                    },
                    {
                      "color": "orange",
                      "value": 90
                    },
                    {
                      "color": "green",
                      "value": 97
                    }
                  ]
                }
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background",
                  "mode": "basic"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Jobs / s"
            },
            "properties": [
              {
                "id": "decimals",
                "value": 2
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "API p95"
            },
            "properties": [
              {
                "id": "unit",
                "value": "s"
              },
              {
                "id": "decimals",
                "value": 3
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "green",
                      "value": null
                    },
                    {
                      "color": "orange",
                      "value": 0.25
                    },
                    {
                      "color": "red",
                      "value": 1
                    }
                  ]
                }
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Backlog"
            },
            "properties": [
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "green",
                      "value": null
                    },
                    {
                      "color": "orange",
                      "value": 20
                    },
                    {
                      "color": "red",
                      "value": 100
                    }
                  ]
                }
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "gauge",
                  "mode": "basic",
                  "valueDisplayMode": "text"
                }
              },
              {
                "id": "max",
                "value": 500
              },
              {
                "id": "min",
                "value": 0
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Install ID"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 260
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "md",
        "sortBy": [
          {
            "displayName": "Job success",
            "desc": false
          }
        ]
      },
      "id": 7,
      "gridPos": {
        "h": 9,
        "w": 16,
        "x": 0,
        "y": 5
      }
    },
    {
      "type": "piechart",
      "title": "Installs by version",
      "datasource": {
        "type": "prometheus",
        "uid": "${ds_prometheus}"
      },
      "description": "Worker version each install is running: a rollout in progress shows up as two slices.",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${ds_prometheus}"
          },
          "expr": "count by (service_version) (count by (nuon_install_id, service_version) (target_info{service_namespace=\"kitchen-sink\", service_name=\"kitchen-sink-worker\", nuon_install_id=~\"$install\"}))",
          "refId": "A",
          "legendFormat": "{{service_version}}",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "pieType": "donut",
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "values": [
            "value"
          ]
        },
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "tooltip": {
          "mode": "single"
        }
      },
      "id": 8,
      "gridPos": {
        "h": 9,
        "w": 8,
        "x": 16,
        "y": 5
      }
    },
    {
      "type": "row",
      "title": "Per install",
      "id": 9,
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 14
      },
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "Job failure rate",
      "description": "Share of background jobs failing, per install. Switch an install's telemetry_demo_profile input to incident to watch it climb.",
      "datasource": {
        "type": "prometheus",
        "uid": "${ds_prometheus}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${ds_prometheus}"
          },
          "expr": "sum by (nuon_install_id, nuon_install_name) ((rate(kitchen_sink_jobs_processed_total{job_outcome=\"failure\"}[$__rate_interval])) * on (job, instance) group_left (nuon_install_id, nuon_install_name) group by (job, instance, nuon_install_id, nuon_install_name) (target_info{service_namespace=\"kitchen-sink\", nuon_install_id=~\"$install\"})) / sum by (nuon_install_id, nuon_install_name) ((rate(kitchen_sink_jobs_processed_total[$__rate_interval])) * on (job, instance) group_left (nuon_install_id, nuon_install_name) group by (job, instance, nuon_install_id, nuon_install_name) (target_info{service_namespace=\"kitchen-sink\", nuon_install_id=~\"$install\"}))",
          "refId": "A",
          "legendFormat": "{{nuon_install_name}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 0,
            "showPoints": "never",
            "spanNulls": true,
            "stacking": {
              "mode": "none",
              "group": "A"
            },
            "thresholdsStyle": {
              "mode": "line+area"
            }
          },
          "color": {
            "mode": "palette-classic"
          },
          "min": 0,
          "thresholds": {

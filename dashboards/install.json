    {
      "type": "timeseries",
      "title": "Job backlog",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "${ds_prometheus}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${ds_prometheus}"
          },
          "expr": "max((kitchen_sink_jobs_backlog) * on (job, instance) group_left (nuon_install_id, nuon_install_name) group by (job, instance, nuon_install_id, nuon_install_name) (target_info{service_namespace=\"kitchen-sink\", nuon_install_id=\"$install\"}))",
          "refId": "A",
          "legendFormat": "backlog"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "line",

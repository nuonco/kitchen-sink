      "title": "Job p95 duration by type",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "${ds_prometheus}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${ds_prometheus}"
          },
          "expr": "histogram_quantile(0.95, sum by (le, job_type) ((rate(kitchen_sink_job_duration_seconds_bucket[$__rate_interval])) * on (job, instance) group_left (nuon_install_id, nuon_install_name) group by (job, instance, nuon_install_id, nuon_install_name) (target_info{service_namespace=\"kitchen-sink\", nuon_install_id=\"$install\"})))",

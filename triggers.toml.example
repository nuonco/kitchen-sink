# triggers — SHIPPED DISABLED. Rename to triggers.toml to sync these rules.
#
# Rules that turn external events into Nuon runs. Every rule below references
# an org-level webhook trigger named `github-events`. Triggers are created
# with the CLI or dashboard — they cannot be declared in app config — and a
# rule referencing a trigger missing from your org fails the whole sync. A
# fresh org has no such trigger, so this file carries a suffix the config
# loader ignores (only *.toml files parse) and a first sync succeeds with no
# trigger rules.
#
# To enable push-to-deploy in your org:
#
#   1. Once per org, create the trigger and point a GitHub webhook
#      (push + release events) on your repo at its ingress URL:
#
#        nuon triggers create github-events --preset github
#        nuon triggers reveal-ingress-url <trigger-id>
#
#   2. Set every `$.repository.full_name` filter below to your repo — as
#      shipped they match only nuonco/kitchen-sink, since Nuon's demo org
#      shares one trigger across apps.
#
#   3. Enable and sync:
#
#        git mv triggers.toml.example triggers.toml
#        nuon sync --app-id <your-app-id> --force
#
# Rules belong to the app config version that synced them, and event routing
# consults only the latest active config — the file has to stay enabled in
# whatever tree you sync from, or the next sync retires the rules.
#
# All rules target the app branch declared in branch.toml. NOTE (verified
# Aug 14): a push to the tracked branch does NOT start a run by itself for a
# [public_repo] branch — the branch-tracking push rule below is what makes
# pushes roll out.

# Every push to the tracked branch fetches the config at that commit and starts
# a staged rollout (each install group still holds for approval). This is how
# agents and CI drive Nuon with no API token: git push is the whole interface.
[[rules]]
name        = "github-push-tracked-branch"
trigger     = "github-events"
event_types = ["push"]

[[rules.filters]]
from  = "payload"
op    = "eq"
path  = "$.ref"
value = "refs/heads/main"

[[rules.filters]]
from  = "payload"
op    = "eq"
path  = "$.repository.full_name"
value = "nuonco/kitchen-sink"

[rules.target]
type       = "app_branch_run"
app_branch = "main"

# Cutting a GitHub release is the deliberate "ship this to customers" signal, as
# opposed to every commit on the tracked branch. Each install group still holds
# for approval, so this starts the rollout without deciding it.
[[rules]]
name        = "github-release-published"
trigger     = "github-events"
event_types = ["release"]

[[rules.filters]]
from  = "payload"
op    = "eq"
path  = "$.action"
value = "published"

[[rules.filters]]
from  = "payload"
op    = "eq"
path  = "$.repository.full_name"
value = "nuonco/kitchen-sink"

[rules.target]
type       = "app_branch_run"
app_branch = "main"

# A version tag is the other ship signal. Tag pushes do not match the tracked
# branch, so they start no run on their own — this makes `git push --tags` roll
# the fleet, which is how a release-tag workflow drives Nuon without an API token.
[[rules]]
name        = "github-version-tag"
trigger     = "github-events"
event_types = ["push"]

[[rules.filters]]
from  = "payload"
op    = "prefix"
path  = "$.ref"
value = "refs/tags/v"

[[rules.filters]]
from  = "payload"
op    = "eq"
path  = "$.repository.full_name"
value = "nuonco/kitchen-sink"

[rules.target]
type       = "app_branch_run"
app_branch = "main"

# Two more patterns, left commented out because each needs a resource that does
# not exist yet and a rule referencing a missing resource fails the sync.
#
# 1. A new image in ECR is what actually changes for this app most of the time:
#    components/images/*.toml pin tags in
#    431927561584.dkr.ecr.us-west-2.amazonaws.com/kitchen-sink-app, and a build
#    there is not a config commit. Needs an EventBridge trigger first:
#
#      nuon triggers create kitchen-sink-ecr --preset aws-eventbridge \
#        --description "ECR image actions for kitchen-sink-app"
#
#    then an EventBridge rule on source aws.ecr, detail-type "ECR Image Action",
#    with an API destination pointing at the trigger's ingress URL.
#
# [[rules]]
# name        = "ecr-image-push"
# trigger     = "kitchen-sink-ecr"
# event_types = ["ECR Image Action"]
#
# [[rules.filters]]
# from  = "payload"
# op    = "eq"
# path  = '$.detail["action-type"]'
# value = "PUSH"
#
# [[rules.filters]]
# from  = "payload"
# op    = "eq"
# path  = "$.detail.result"
# value = "SUCCESS"
#
# [[rules.filters]]
# from  = "payload"
# op    = "eq"
# path  = '$.detail["repository-name"]'
# value = "kitchen-sink-app"
#
# [rules.target]
# type       = "app_branch_run"
# app_branch = "main"
#
# 2. A `runbook` target runs on one named install rather than a branch, which is
#    how an alert becomes a diagnostic bundle. `install` must name an install
#    that exists in your org — set it to one of yours, create the trigger, and
#    then uncomment:
#
#      nuon triggers create kitchen-sink-datadog --preset datadog
#
# [[rules]]
# name        = "alert-collect-debug-bundle"
# trigger     = "kitchen-sink-datadog"
# event_types = ["alert"]
#
# [[rules.filters]]
# from  = "payload"
# op    = "eq"
# path  = "$.alert_transition"
# value = "Triggered"
#
# [rules.target]
# type    = "runbook"
# runbook = "debug-bundle"
# install = "<your-install-name>"
